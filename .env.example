# Токен бота от @BotFather
TG_BOT_TOKEN=
# Тестовая среда Telegram для проверки оплаты: true + токен бота от тестового @BotFather
TG_TEST_ENV=false
TG_TEST_BOT_TOKEN=

# Ключ Claude API: platform.claude.com → Settings → API Keys
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — глубина рассуждений и расход токенов
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
# Тестовый режим без Claude API и без ключа: заготовленные ответы.
# Кодовые слова: fake:unreadable, fake:not_a_problem, fake:refusal, fake:max_tokens, fake:error, fake:long
LLM_FAKE=false

# Лимиты на календарный месяц (UTC). Бюджеты — скрытые потолки расходов на LLM в $
FREE_SOLUTIONS_PER_MONTH=15
FREE_BUDGET_USD=0.90
PAID_BUDGET_USD=2
# Подписка: цена в Telegram Stars за 30 дней
SUBSCRIPTION_PRICE_STARS=250
# Контакт для /paysupport
SUPPORT_CONTACT=@your_username

# Запросов к LLM в минуту на пользователя
RATE_LIMIT_PER_MINUTE=6

# Локальный запуск вне Docker. В docker compose эти значения переопределяются.
DATABASE_URL=postgresql+asyncpg://tutor:tutor@localhost:5432/tutor
REDIS_URL=redis://localhost:6379/0

# Telegram ID админов через запятую
ADMIN_IDS=

LOG_LEVEL=INFO
